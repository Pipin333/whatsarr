# Puerto del servidor local para API, Webhooks y Dashboard UI
PORT=3001

# Rutas de almacenamiento en disco para tu contenido multimedia
MOVIES_PATH=C:\Media\Peliculas
SERIES_PATH=C:\Media\Series

# Configuración de Radarr (Películas)
# La API Key se encuentra en: Radarr -> Settings -> General -> API Key
RADARR_URL=http://localhost:7878
RADARR_API_KEY=

# Configuración de Sonarr (Series)
# La API Key se encuentra en: Sonarr -> Settings -> General -> API Key
SONARR_URL=http://localhost:8989
SONARR_API_KEY=

# Configuración de Prowlarr (Búsqueda de Indexers)
# En Windows se autodetecta si está en C:\ProgramData\Prowlarr\config.xml
PROWLARR_URL=http://localhost:9696
PROWLARR_API_KEY=

# Configuración de qBittorrent WebUI
QBITTORRENT_URL=http://127.0.0.1:8080

# Configuración de Plex Media Server
# En Windows se autodetecta desde el registro HKCU si no se define aquí
PLEX_URL=http://localhost:32400
PLEX_TOKEN=

# (Recomendado) Google Gemini AI para normalización de lenguaje natural de peticiones
# Obtén tu clave gratuita en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# (Opcional) The Movie Database (TMDB) API Key
# Si se deja vacío, el bot usará automáticamente la búsqueda integrada de Radarr/Sonarr
TMDB_API_KEY=

# Palabras clave que activan el bot en WhatsApp (separadas por coma)
TRIGGER_KEYWORDS=quiero ver,!pedir,!ver,descargar,búscame,buscame

# Whitelist de números autorizados (separados por coma, formato internacional sin símbolos)
# Ejemplo: 56912345678,5491112345678
# Si se deja vacío, el bot opera en modo abierto (atiende a cualquier contacto)
ALLOWED_NUMBERS=
