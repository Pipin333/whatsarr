# Local server port for REST API, Webhooks, and Web UI Dashboard
PORT=3001

# Bot language for WhatsApp messages & interactive prompts ('en' for English, 'es' for Spanish)
BOT_LANGUAGE=en

# Storage paths on your local drive for media content
MOVIES_PATH=C:\Media\Movies
SERIES_PATH=C:\Media\TV

# Radarr Configuration (Movies)
# API key is located in: Radarr -> Settings -> General -> API Key
RADARR_URL=http://localhost:7878
RADARR_API_KEY=

# Sonarr Configuration (TV Shows)
# API key is located in: Sonarr -> Settings -> General -> API Key
SONARR_URL=http://localhost:8989
SONARR_API_KEY=

# Prowlarr Configuration (Torrent Indexers Manager)
# On Windows, this is automatically detected if located at C:\ProgramData\Prowlarr\config.xml
PROWLARR_URL=http://localhost:9696
PROWLARR_API_KEY=

# qBittorrent WebUI Configuration
QBITTORRENT_URL=http://127.0.0.1:8080

# Plex Media Server Configuration
# On Windows, the token is automatically read from HKCU registry if left empty
PLEX_URL=http://localhost:32400
PLEX_TOKEN=

# (Recommended) Google Gemini AI API key for natural language request parsing
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# (Optional) The Movie Database (TMDB) API Key
# If omitted, the bot will fall back to Sonarr/Radarr built-in search
TMDB_API_KEY=

# Trigger keywords for activating the bot via WhatsApp (comma-separated)
TRIGGER_KEYWORDS=want to watch,download,!request,!get,quiero ver,!pedir,!ver,descargar

# Authorized phone numbers whitelist (comma-separated, international format without symbols)
# Example: 15551234567,447911123456
# If left empty, the bot operates in open mode (responds to any authorized sender)
ALLOWED_NUMBERS=
