{
  "name": "plex-whatsapp-bot",
  "version": "1.0.0",
  "description": "Bot de WhatsApp para solicitar contenido en Plex y avisar al completarse la descarga",
  "main": "src/index.js",
  "type": "commonjs",
  "license": "MIT",
  "scripts": {
    "start": "node src/index.js",
    "test-webhook": "node test/simulate-webhook.js",
    "test-search": "node test/test-search.js",
    "test-streaming": "node test/test-progressive-streamer.js",
    "configure:trackers": "node scripts/configure-trackers.js",
    "configure:clients": "node scripts/configure-download-clients.js",
    "reset:whatsapp": "node scripts/reset-whatsapp.js",
    "docker:build": "docker build -t plex-whatsapp-bot .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:full-stack": "docker compose -f docker-compose.full-stack.yml up -d"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.9",
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "fuzzball": "^2.2.6",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0"
  }
}
