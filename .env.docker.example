# ==============================================================================
# Plex WhatsApp Bot - Variables de Entorno para Docker
# Copia este archivo a '.env' antes de ejecutar: docker compose up -d
# ==============================================================================

# Puerto local del servidor Webhook, API y Dashboard Web
PORT=3001

# Idioma de interacción del bot de WhatsApp ('es' para español, 'en' para inglés)
BOT_LANGUAGE=es

# Rutas de almacenamiento de medios en el host o dentro del contenedor
# Si ejecutas el bot conectándose a servicios en tu máquina host:
MOVIES_PATH=/media/movies
SERIES_PATH=/media/series

# ==============================================================================
# Conexión a Servicios (Radarr, Sonarr, Prowlarr, qBittorrent, Plex)
# ==============================================================================
# NOTA IMPORTANTE PARA DOCKER:
# Si tus servicios corren en el sistema host (Windows/Linux/Mac):
#   Usa 'http://host.docker.internal:<puerto>' en lugar de 'localhost' o '127.0.0.1'.
# Si usas docker-compose.full-stack.yml:
#   Usa los nombres de servicio de Docker: 'http://radarr:7878', 'http://sonarr:8989', etc.

# Radarr (Películas)
RADARR_URL=http://host.docker.internal:7878
RADARR_API_KEY=tu_api_key_de_radarr

# Sonarr (Series de TV)
SONARR_URL=http://host.docker.internal:8989
SONARR_API_KEY=tu_api_key_de_sonarr

# Prowlarr (Indexers / Trackers)
PROWLARR_URL=http://host.docker.internal:9696
PROWLARR_API_KEY=tu_api_key_de_prowlarr

# qBittorrent WebUI
QBITTORRENT_URL=http://host.docker.internal:8080

# Plex Media Server
PLEX_URL=http://host.docker.internal:32400
PLEX_TOKEN=tu_plex_online_token

# ==============================================================================
# Inteligencia Artificial & Búsqueda
# ==============================================================================
# (Recomendado) Google Gemini AI API key para comprensión en lenguaje natural
# Consíguela gratis en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_gemini_api_key
GEMINI_MODEL=gemini-flash-latest

# (Opcional) The Movie Database (TMDB) API Key
TMDB_API_KEY=

# Palabras clave de activación del bot (separadas por coma)
TRIGGER_KEYWORDS=quiero ver,!pedir,!ver,descargar,búscame,buscame,want to watch,!request

# Whitelist de números de teléfono autorizados (separados por coma, formato internacional sin símbolos)
# Ej: 56912345678,34612345678
# Si se deja vacío, cualquier usuario de WhatsApp puede interactuar con el bot
ALLOWED_NUMBERS=
